<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts Dalker in every user's graphical session at login (installed to
     /Library/LaunchAgents). Screen capture and input only work inside that session. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.ivanmakhnyk.Dalker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Dalker.app/Contents/MacOS/dalkerd</string>
    </array>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after "Quit Dalker" in the menu bar. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
